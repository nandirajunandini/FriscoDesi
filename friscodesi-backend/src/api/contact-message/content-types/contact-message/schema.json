{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "ContactMessage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "messageStatus": {
      "type": "enumeration",
      "enum": [
        "new",
        "read",
        "replied",
        "archived"
      ]
    },
    "message": {
      "type": "string"
    },
    "adminReply": {
      "type": "text"
    }
  }
}
